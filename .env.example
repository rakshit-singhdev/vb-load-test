# ---- Required -------------------------------------------------------------
# Virtual Buzzer backend (same value as VITE_BUZZER_BACKEND_URL), no trailing /v1
BACKEND_URL=https://buzzer.awspf.com
# 4-digit pin from the host screen
PIN=1234
# Start time in IST: "dd mm hh mm ss" (day month hour minute second, 24h), or "now"
START_AT=06 11 18 30 00

# ---- Players --------------------------------------------------------------
PLAYERS=40
# Spread joins evenly over this many seconds (0 = everyone at the same instant)
JOIN_SPREAD_SEC=20
# Team games: bots per team (1 = every bot founds its own team). Ignored in solo games.
TEAM_SIZE=1
NAME_PREFIX=Bot

# ---- Buzzing --------------------------------------------------------------
# Chance (0-1) each bot buzzes when the host arms
BUZZ_PROBABILITY=0.9
# Human-ish reaction time after armAt, uniform between these (ms)
BUZZ_MIN_MS=150
BUZZ_MAX_MS=1500
# ably (like a phone; HTTP only as fallback) | http | both (tests nonce dedupe)
BUZZ_TRANSPORT=ably
# % of buzzes double-tapped with the same nonce (server must count once)
DUPLICATE_BUZZ_PCT=0
# Chance (0-1) a bot not in the order buzzes late while the host is judging
LATE_BUZZ_PROBABILITY=0

# ---- Chaos (reconnect / rejoin testing) -----------------------------------
# % of bots whose Ably connection is dropped every CHAOS_INTERVAL_SEC, back after CHAOS_DOWN_SEC
CHAOS_DROP_PCT=0
CHAOS_INTERVAL_SEC=60
CHAOS_DOWN_SEC=8

# ---- Run control ----------------------------------------------------------
# Leave after this many minutes even if the host never ends the game
STAY_MIN=120
REPORT_EVERY_SEC=30
REQUEST_TIMEOUT_MS=10000
JOIN_RETRIES=6
VERBOSE=false
# CLI only: write the final JSON report to this file
# REPORT_FILE=report.json

# ---- Render web service only ----------------------------------------------
# Enables GET/POST /run and /stop. Use a long random string.
CONTROL_TOKEN=
# Self-ping interval while a run is scheduled/active (free plan sleeps after 15 min idle)
KEEP_ALIVE_MIN=10
# while-running | always | off
KEEP_ALIVE=while-running
# After a restart, a START_AT up to this many minutes old still starts immediately
LATE_START_GRACE_MIN=5
# RENDER_EXTERNAL_URL is set by Render automatically; KEEP_ALIVE_URL overrides it
# KEEP_ALIVE_URL=
